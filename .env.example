# This is a template for the `.env` file that is used as part of local development.
# You can copy this file, rename it to `.env` and fill in the missing values,
# then delete this header.
###############################################################################

# This file should contain all the secrets required by *development* (local) application.
# This file is ignored by git by default to avoid accidentally exposing secrets in your repository.

SECRET_KEY="django-insecure-yGgc2F6ItlonpCKbwDYLENz2r1DAIAWzZ343C3tA"
# host should be "localhost" for native development or "db" for docker-based development
DATABASE_URL="postgresql://postgres:postgres@db:5432/novena_hub"
REMOTE_CONTROL_SIGNING_KEY_ID="replace-with-managed-key-id"
REMOTE_CONTROL_SIGNING_PRIVATE_KEY=""
REMOTE_CONTROL_ACTIVE_SIGNING_KEY_ID="replace-with-managed-key-id"
REMOTE_CONTROL_SIGNING_KEYS="{}"
REMOTE_CONTROL_AUDIT_RETENTION_DAYS="2555"
REMOTE_CONTROL_OUTBOX_LEASE_SECONDS="60"
REMOTE_CONTROL_OUTBOX_MAX_ATTEMPTS="5"
REMOTE_CONTROL_OUTBOX_RETRY_BASE_SECONDS="5"
REMOTE_CONTROL_OUTBOX_RETRY_MAX_SECONDS="300"
GATEWAY_CONFIG_ENVELOPE_TTL_SECONDS="300"
GATEWAY_CONFIG_OUTBOX_LEASE_SECONDS="60"
GATEWAY_CONFIG_OUTBOX_MAX_ATTEMPTS="5"
GUIDED_SETUP_FIRST_TELEMETRY_TIMEOUT_SECONDS="180"
# host should be "localhost" for native development or "redis" for docker-based development
REDIS_URL="redis://redis:6379"

GOOGLE_ANALYTICS_ID=""
# Canonical public host; app login/signup use APP_DOMAIN in production.
MARKETING_SITE_DOMAIN="www.novenaplatform.com"
SENTRY_DSN=""

CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Social login credentials go here

GOOGLE_CLIENT_ID=""
GOOGLE_SECRET_ID=""

# turnstile setup - add your keys here to enable turnstile
TURNSTILE_KEY=""
TURNSTILE_SECRET=""

# put your stripe keys here
STRIPE_LIVE_PUBLIC_KEY="pk_live_***"
STRIPE_LIVE_SECRET_KEY="sk_live_***"
STRIPE_TEST_PUBLIC_KEY="pk_test_***"
STRIPE_TEST_SECRET_KEY="sk_test_***"
STRIPE_PRICING_TABLE_ID="prctbl_***"

ENABLE_DEBUG_TOOLBAR=True

# public media storage config
USE_S3_MEDIA=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon SES email
EMAIL_BACKEND="anymail.backends.amazon_ses.EmailBackend"
AWS_SES_REGION_NAME="ap-southeast-1"
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""
AWS_SES_CONFIGURATION_SET_NAME=""
ANYMAIL_WEBHOOK_SECRET=""
DEFAULT_FROM_EMAIL="Novena Platform <alerts@your-domain.com>"
SERVER_EMAIL="server@your-domain.com"
CONTACT_EMAIL="support@your-domain.com"

HEALTH_CHECK_TOKENS=

AI_CHAT_DEFAULT_LLM_MODEL="gpt-4o"
AI_CHAT_OPENAI_API_KEY="sk-***"
GEMINI_API_KEY=""

# WhatsApp Cloud API
# Use "mock" locally to log WhatsApp sends without calling Meta. Use "meta" when the
# WhatsApp Business app, phone number, access token, and webhook are configured.
WHATSAPP_PROVIDER="mock"
WHATSAPP_GRAPH_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
# Use "hello_world" while testing Meta's sandbox. For real alerts, create the
# template documented in docs/whatsapp_integration_setup.md and set its name here.
WHATSAPP_ALERT_TEMPLATE_NAME="hello_world"
WHATSAPP_ALERT_TEMPLATE_LANGUAGE="en_US"
