[Unit]
Description=Novena database and private report backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/novena/Novena-Hub
Environment=NOVENA_ROOT=/opt/novena/Novena-Hub
Environment=NOVENA_BACKUP_DB_MODE=compose
Environment=NOVENA_OFFSITE_REQUIRED=1
Environment=NOVENA_BACKUP_DIR=/var/backups/novena/postgres
Environment=NOVENA_PRIVATE_MEDIA_BACKUP_DIR=/var/backups/novena/private-media
Environment=RCLONE_CONFIG=/etc/novena/rclone.conf
EnvironmentFile=/etc/novena/backup.env
ExecStart=/usr/local/sbin/novena-backup-postgres
ExecStart=/usr/local/sbin/novena-backup-private-media
ExecStartPost=/usr/local/sbin/novena-backup-retention
