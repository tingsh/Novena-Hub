[Unit]
Description=Novena Mosquitto Dynamic Security backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=NOVENA_ROOT=/opt/novena/Novena-Hub
EnvironmentFile=-/etc/novena/mqtt-backup.env
ExecStart=/usr/local/sbin/novena-backup-mqtt-dynsec
