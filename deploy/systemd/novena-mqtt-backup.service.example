[Unit]
Description=Novena Mosquitto Dynamic Security backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=NOVENA_ROOT=/opt/novena/Novena-Hub
Environment=NOVENA_OFFSITE_REQUIRED=1
Environment=RCLONE_CONFIG=/etc/novena/rclone.conf
EnvironmentFile=/etc/novena/backup.env
ExecStart=/usr/local/sbin/novena-backup-mqtt-dynsec
