# Copy to deploy/env/production.env on the production server and fill every secret.
# Never commit deploy/env/production.env.

NOVENA_DEPLOYMENT_MODE=production

# Governed remote control (base64 Ed25519 seeds come from managed secrets)
REMOTE_CONTROL_ACTIVE_SIGNING_KEY_ID=
REMOTE_CONTROL_SIGNING_KEYS={}
REMOTE_CONTROL_SIGNING_PRIVATE_KEY=
REMOTE_CONTROL_AUDIT_RETENTION_DAYS=2555
REMOTE_CONTROL_OUTBOX_LEASE_SECONDS=60
REMOTE_CONTROL_OUTBOX_MAX_ATTEMPTS=5
REMOTE_CONTROL_OUTBOX_RETRY_BASE_SECONDS=5
REMOTE_CONTROL_OUTBOX_RETRY_MAX_SECONDS=300
GATEWAY_CONFIG_ENVELOPE_TTL_SECONDS=300
GATEWAY_CONFIG_OUTBOX_LEASE_SECONDS=60
GATEWAY_CONFIG_OUTBOX_MAX_ATTEMPTS=5
GATEWAY_CONFIG_INTENT_TTL_SECONDS=86400
GATEWAY_CONFIG_APPLY_TIMEOUT_SECONDS=300
GUIDED_SETUP_FIRST_TELEMETRY_TIMEOUT_SECONDS=180

# Gateway OTA updates are optional during unpaid pilots. Leave the private key
# blank if OTA updates are disabled operationally. Configure before using the
# signed Gateway software update flow.
NOVENA_OTA_SIGNING_PRIVATE_KEY=
NOVENA_OTA_SIGNING_KEY_ID=novena-ota-v1
NOVENA_OTA_MANIFEST_TTL_DAYS=14

DJANGO_SETTINGS_MODULE=novena_hub.settings_production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-django-secret
ALLOWED_HOSTS=novenaplatform.com,www.novenaplatform.com,app.novenaplatform.com
APP_DOMAIN=app.novenaplatform.com
MARKETING_SITE_DOMAIN=www.novenaplatform.com
SESSION_COOKIE_DOMAIN=.novenaplatform.com
FRONTEND_ADDRESS=https://app.novenaplatform.com
ACCOUNT_EMAIL_VERIFICATION=optional
CORS_ALLOWED_ORIGINS=https://novenaplatform.com,https://www.novenaplatform.com,https://app.novenaplatform.com
CSRF_TRUSTED_ORIGINS=https://novenaplatform.com,https://www.novenaplatform.com,https://app.novenaplatform.com
APP_BASE_URL=https://app.novenaplatform.com
USE_HTTPS_IN_ABSOLUTE_URLS=True
HEALTH_CHECK_TOKENS=replace-with-health-check-token
SENTRY_DSN=
DJANGO_LOG_LEVEL=INFO
NOVENA_HUB_LOG_LEVEL=INFO

POSTGRES_DB=novena_hub
POSTGRES_USER=novena
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_URL=postgresql://novena:replace-with-postgres-password@postgres:5432/novena_hub
REDIS_URL=redis://redis:6379/0

MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_CONSUMER_CLIENT_ID=novena-hub-consumer-prod
MQTT_PUBLISHER_CLIENT_ID=novena-hub-publisher-prod
MQTT_DYNSEC_PORT=1884
MQTT_DYNSEC_ADMIN_USER=replace-with-dynsec-admin
MQTT_DYNSEC_ADMIN_PASS=replace-with-dynsec-password
MQTT_PROVISIONING_REQUIRED=True
MQTT_ACCEPT_LEGACY_SHARED_INBOUND=False
GATEWAY_CLAIM_SECRET=replace-with-gateway-claim-secret
GATEWAY_ACTIVATION_ENCRYPTION_KEY=replace-with-fernet-key
GATEWAY_ACTIVATION_TTL_HOURS=24
GATEWAY_ACTIVATION_REISSUE_COOLDOWN_SECONDS=300
MQTT_DYNSEC_RESPONSE_TIMEOUT_SECONDS=5
GATEWAY_RELEASE_LEASE_SECONDS=60
GATEWAY_RELEASE_RETRY_MAX_SECONDS=300
PUBLIC_MQTT_BROKER_SCHEME=mqtts
PUBLIC_MQTT_BROKER_HOST=mqtt.novenaplatform.com
PUBLIC_MQTT_BROKER_PORT=8883
DEVICE_OFFLINE_MIN_SECONDS=30
DEVICE_OFFLINE_MULTIPLIER=3
DEVICE_DELAYED_MULTIPLIER=2
GATEWAY_OFFLINE_SECONDS=120

EMAIL_BACKEND=anymail.backends.amazon_ses.EmailBackend
AWS_SES_REGION_NAME=ap-southeast-1
AWS_SES_ACCESS_KEY_ID=replace-with-ses-key
AWS_SES_SECRET_ACCESS_KEY=replace-with-ses-secret
AWS_SES_CONFIGURATION_SET_NAME=
ANYMAIL_WEBHOOK_SECRET=
DEFAULT_FROM_EMAIL=Novena Platform <no-reply@alerts.novenaplatform.com>
SERVER_EMAIL=server@novenaplatform.com
CONTACT_EMAIL=support@novenaplatform.com

WHATSAPP_PROVIDER=meta
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-meta-token
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_ALERT_TEMPLATE_NAME=novena_alert_notification
WHATSAPP_ALERT_TEMPLATE_LANGUAGE=en

STRIPE_LIVE_MODE=False
DJSTRIPE_WEBHOOK_VALIDATION=verify_signature
STRIPE_TEST_PUBLIC_KEY=pk_test_replace
STRIPE_TEST_SECRET_KEY=sk_test_replace
STRIPE_LIVE_PUBLIC_KEY=pk_live_replace-before-paid-launch
STRIPE_LIVE_SECRET_KEY=sk_live_replace-before-paid-launch
DJSTRIPE_WEBHOOK_SECRET=whsec_replace-before-paid-launch
STRIPE_PRICING_TABLE_ID=prctbl_replace-before-paid-launch

AI_CHAT_DEFAULT_LLM_MODEL=gpt-4o
AI_CHAT_OPENAI_API_KEY=
AI_CHAT_ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_ANALYTICS_ID=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_ID=
TURNSTILE_KEY=
TURNSTILE_SECRET=

# Local filesystem media is cheapest for the first VPS deployment. If you later
# move media/report storage to S3-compatible object storage, fill these and
# update backup/restore runbooks accordingly.
USE_S3_MEDIA=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=novena_hub-media
BACKUP_RCLONE_REMOTE=
PRIVATE_MEDIA_BACKUP_RCLONE_REMOTE=

WEB_CONCURRENCY=2
