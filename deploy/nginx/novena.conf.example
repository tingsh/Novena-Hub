map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name novenaplatform.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://www.novenaplatform.com$request_uri;
    }
}

server {
    listen 80;
    server_name www.novenaplatform.com app.novenaplatform.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name novenaplatform.com;

    ssl_certificate /etc/letsencrypt/live/novenaplatform.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/novenaplatform.com/privkey.pem;

    return 301 https://www.novenaplatform.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.novenaplatform.com app.novenaplatform.com;

    ssl_certificate /etc/letsencrypt/live/novenaplatform.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/novenaplatform.com/privkey.pem;

    client_max_body_size 25m;

    location /static/ {
        alias /opt/novena/Novena-Hub/static_root/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
    }

    location ^~ /media/equipment-template-requests/ {
        return 404;
    }

    location /media/ {
        alias /opt/novena/Novena-Hub/media/;
        expires 1h;
        add_header Cache-Control "private, max-age=3600";
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
